# Copy to supabase/functions/.env for local edge functions (`npx supabase start`
# picks it up). Staging/production set the same names with `supabase secrets set`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided automatically.
AI_API_KEY=
# AI_MODEL=gemini-3.5-flash
# Razorpay TEST keys only, outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
