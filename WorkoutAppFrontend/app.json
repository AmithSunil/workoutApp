{
  "expo": {
    "name": "Corda",
    "slug": "corda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corda",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fit.corda.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DD4410",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fit.corda.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of your meal so the AI can estimate its macros.",
          "photosPermission": "Choose a photo of your meal so the AI can estimate its macros.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F8F9FC"
  }
}
