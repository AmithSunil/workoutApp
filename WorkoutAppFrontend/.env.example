# Copy to .env.local. Both values are public (anon/publishable) keys — they are
# safe in the client bundle, but every table must still be protected by RLS.
# Restart `npx expo start` after changing this file.

# Local Supabase (`npx supabase start` in WorkoutAppBackend/). The key is the
# CLI's fixed demo anon key, the same on every machine. Testing on a phone over
# Wi-Fi: use this computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Staging (the hosted project): Supabase Dashboard -> Project Settings -> API.
# EXPO_PUBLIC_SUPABASE_URL=https://vxytcykmeskjdyxtrjco.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=

# Which transport backs the RTK Query endpoints. Unset (the default) talks to
# Supabase; `mock` serves the bundled in-memory fixtures instead, which is what
# `npm run verify` uses to drive the app with no network.
# EXPO_PUBLIC_API_TRANSPORT=mock
